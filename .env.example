# Copy to .env.local (git-ignored). Values live in Supabase → Project Settings → API
# and in Vercel → Settings → Environment Variables. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Comma-separated admin login emails; /admin is disabled when empty.
ADMIN_EMAILS=
